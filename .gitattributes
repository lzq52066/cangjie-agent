# 部署到 Linux 的文本文件统一 LF，避免 Windows 检出后被转成 CRLF
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.conf text eol=lf
*.env text eol=lf
.env* text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf
*.Dockerfile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows 脚本保持 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
