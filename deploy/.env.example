# ============================================================
# CangJie Agent 制品部署环境变量
# 执行 ./scripts/02-init.sh 会自动由本文件生成 .env
# ============================================================

# ---------- 对外 Web 端口（Nginx 托管前端并反代后端/MinIO） ----------
WEB_PORT=80
# HTTPS 端口（可选）：把证书放到 deploy/frontend/certs/ 下，命名 server.crt（含证书链）+
# server.key，再执行 docker compose restart frontend，Nginx 即监听 443 并把 80 的请求 301 跳转过来
WEB_SSL_PORT=443

# ---------- PostgreSQL（仅容器内网使用，不对宿主机/公网暴露端口） ----------
POSTGRES_DB=cangjie_agent
POSTGRES_USER=cangjie
POSTGRES_PASSWORD=cangjie123
POSTGRES_PORT=5432

# ---------- Redis（仅容器内网使用，不对宿主机/公网暴露端口） ----------
REDIS_PASSWORD=cangjie123
REDIS_PORT=6379

# ---------- MinIO（9000/9001 仅容器内网使用，统一经 80 端口的 Nginx 反代） ----------
MINIO_ACCESS_KEY=cangjie
MINIO_SECRET_KEY=cangjie123
MINIO_BUCKET=cangjie-files
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# 【重要】浏览器访问文件（预签名 URL）的根地址，不带路径、不带端口：
#   http://<服务器公网IP>   或   https://files.your-domain.com
# 实际文件地址为该地址 + /<桶名>/<对象路径>，由 Nginx 转发到内网 MinIO
MINIO_PUBLIC_ENDPOINT=http://localhost
# 控制台对外地址（Nginx 子路径）
MINIO_CONSOLE_PUBLIC_URL=http://localhost/minio-console

# ---------- Embedding（知识库向量化，OpenAI 兼容服务，维度需为 1024） ----------
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024

# ---------- 安全密钥（生产环境务必修改） ----------
# 下面两项由 ./02-init.sh 首次生成 .env 时自动随机化，其余账号密码均为固定默认值，可直接使用
CANGJIE_MODEL_KEY_SECRET=change-me-model-key-secret-32chars
SA_TOKEN_JWT_SECRET_KEY=change-me-to-a-random-64-chars-string
# ---------- 管理员初始账号 ----------
# 仅用于首次登录：用初始密码登录后系统会强制要求修改，之后此值不再影响已设置的密码
SYSTEM_DEFAULT_USERNAME=admin
SYSTEM_DEFAULT_PASSWORD=cangjie123

# ---------- JVM ----------
JAVA_OPTS=-Xms512m -Xmx2g
