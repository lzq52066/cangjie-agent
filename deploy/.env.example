# ============================================================
# CangJie Agent 制品部署环境变量
# 执行 ./scripts/02-init.sh 会自动由本文件生成 .env
# ============================================================

# ---------- 对外 Web 端口（Nginx） ----------
WEB_PORT=80

# ---------- PostgreSQL ----------
POSTGRES_DB=cangjie_agent
POSTGRES_USER=cangjie
POSTGRES_PASSWORD=cangjie_secret
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379

# ---------- MinIO ----------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=cangjie-files
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# 【重要】浏览器访问文件（预签名 URL）的地址，部署到服务器请改为：
#   http://<服务器公网IP>:9000   或   https://minio.your-domain.com
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# ---------- Embedding（知识库向量化，OpenAI 兼容服务，维度需为 1024） ----------
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024

# ---------- 安全密钥（生产环境务必修改） ----------
CANGJIE_MODEL_KEY_SECRET=change-me-model-key-secret-32chars
SA_TOKEN_JWT_SECRET_KEY=change-me-to-a-random-64-chars-string
SYSTEM_DEFAULT_PASSWORD=cangjiecloud@123

# ---------- JVM ----------
JAVA_OPTS=-Xms512m -Xmx2g
