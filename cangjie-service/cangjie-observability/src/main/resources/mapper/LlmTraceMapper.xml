<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.cangjiecloud.observability.mapper.LlmTraceMapper">

    <!-- 按保留期分批物理删除模型调用追踪（绕过逻辑删除回收空间） -->
    <delete id="purgeBatch">
        DELETE FROM llm_trace WHERE id IN (
            SELECT id FROM llm_trace WHERE start_time &lt; #{cutoff} LIMIT #{batchSize}
        )
    </delete>

</mapper>
