<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.cangjiecloud.observability.mapper.TraceRecordMapper">

    <!-- 按保留期分批物理删除 span（绕过逻辑删除回收载荷空间） -->
    <delete id="purgeBatch">
        DELETE FROM trace_record WHERE id IN (
            SELECT id FROM trace_record WHERE start_time &lt; #{cutoff} LIMIT #{batchSize}
        )
    </delete>

</mapper>
