<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.cangjiecloud.observability.mapper.SystemMetricMapper">

    <!-- 按保留期分批物理删除历史指标（绕过逻辑删除回收空间） -->
    <delete id="purgeBatch">
        DELETE FROM system_metric WHERE id IN (
            SELECT id FROM system_metric WHERE collect_time &lt; #{cutoff} LIMIT #{batchSize}
        )
    </delete>

</mapper>
